{
  "name": "drawing-Registrar",
  "version": "1.0.0",
  "description": "CLI tool to automatically rename AutoCAD PDF drawings using a PDF drawing register.",
  "main": "Registrar.js",
  "type": "commonjs",
  "bin": {
    "rename-drawings": "./Registrar.js"
  },
  "scripts": {
    "start": "node Registrar.js",
    "copy-libs": "node scripts/copy-libs.js",
    "start-gui": "npm run copy-libs && neu run",
    "build-gui": "npm run copy-libs && neu build --release --embed-resources"
  },
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "dictionary-en-gb": "^3.0.0",
    "jszip": "^3.10.2",
    "nspell": "^2.1.5",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1"
  },
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "@neutralinojs/neu": "^11.7.2"
  }
}
