{
  "name": "drawing-renamer",
  "version": "1.0.0",
  "description": "CLI tool to automatically rename AutoCAD PDF drawings using a PDF drawing register.",
  "main": "renamer.js",
  "type": "commonjs",
  "bin": {
    "rename-drawings": "./renamer.js"
  },
  "scripts": {
    "start": "node renamer.js",
    "copy-pdfjs": "node scripts/copy-pdfjs.js",
    "start-gui": "npm run copy-pdfjs && neu run",
    "build-gui": "npm run copy-pdfjs && neu build --release --embed-resources"
  },
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "pdf-parse": "^1.1.1"
  },
  "engines": {
    "node": ">=16"
  }
}
